// ---------------------------------------------------------------------------
// Vectors, 4x4 matrices, and the few functions of a real they need.
//
// wasm32 has no C library, so the trigonometry is the host's: JavaScript's
// Math, handed in as imports by web/app.js. Natively -- under `ode test` --
// the same names are the C library's, so the tests run the same code.
//
// A matrix is 16 f32s behind a pointer, column-major as GL reads it, so one
// written here goes to a shader as it is.
// ---------------------------------------------------------------------------

import { alloc } from "std/mem";

export extern fn sin(x: f64): f64;
export extern fn cos(x: f64): f64;
export extern fn tan(x: f64): f64;
export extern fn exp(x: f64): f64;
export extern fn pow(x: f64, y: f64): f64;

export let PI: f32 = 3.14159265;

export fn sine(x: f32): f32 {
  return sin(x as f64) as f32;
}

export fn cosine(x: f32): f32 {
  return cos(x as f64) as f32;
}

export fn power(x: f32, y: f32): f32 {
  return pow(x as f64, y as f64) as f32;
}

export fn exponent(x: f32): f32 {
  return exp(x as f64) as f32;
}

export fn clamp(value: f32, low: f32, high: f32): f32 {
  if (value < low) {
    return low;
  }
  if (value > high) {
    return high;
  }
  return value;
}

export fn smaller(a: f32, b: f32): f32 {
  if (a < b) {
    return a;
  }
  return b;
}

export fn larger(a: f32, b: f32): f32 {
  if (a > b) {
    return a;
  }
  return b;
}

export fn absolute(x: f32): f32 {
  if (x < 0.0) {
    return 0.0 - x;
  }
  return x;
}

// Newton's method: a square root needs no import, so meshes build without
// one.
export fn squareRoot(value: f32): f32 {
  if (value <= 0.0) {
    return 0.0;
  }
  let guess: f32 = value;
  if (guess < 1.0) {
    guess = 1.0;
  }
  for (i in 0..16) {
    guess = (guess + value / guess) * 0.5;
  }
  return guess;
}

export struct Vec3 {
  x: f32,
  y: f32,
  z: f32,

  fn new(x: f32, y: f32, z: f32): Vec3 {
    return Vec3 { x: x, y: y, z: z };
  }

  fn add(self: Vec3, other: Vec3): Vec3 {
    return Vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z };
  }

  fn sub(self: Vec3, other: Vec3): Vec3 {
    return Vec3 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z };
  }

  fn scale(self: Vec3, by: f32): Vec3 {
    return Vec3 { x: self.x * by, y: self.y * by, z: self.z * by };
  }

  fn dot(self: Vec3, other: Vec3): f32 {
    return self.x * other.x + self.y * other.y + self.z * other.z;
  }

  fn cross(self: Vec3, other: Vec3): Vec3 {
    return Vec3 {
      x: self.y * other.z - self.z * other.y,
      y: self.z * other.x - self.x * other.z,
      z: self.x * other.y - self.y * other.x,
    };
  }

  fn lerp(self: Vec3, other: Vec3, t: f32): Vec3 {
    return self.add(other.sub(self).scale(t));
  }

  fn length(self: Vec3): f32 {
    return squareRoot(self.dot(self));
  }

  fn normalized(self: Vec3): Vec3 {
    let length: f32 = self.length();
    if (length == 0.0) {
      return self;
    }
    return self.scale(1.0 / length);
  }

  // Into three floats at `out`, for a uniform.
  fn write(self: Vec3, out: *f32): void {
    out[0] = self.x;
    out[1] = self.y;
    out[2] = self.z;
  }
}

// ---------------------------------------------------------------------------
// Matrices
// ---------------------------------------------------------------------------

fn zero(out: *f32): void {
  for (i in 0..16) {
    out[i] = 0.0;
  }
}

export fn identity(out: *f32): void {
  zero(out);
  out[0] = 1.0;
  out[5] = 1.0;
  out[10] = 1.0;
  out[15] = 1.0;
}

export fn perspective(out: *f32, fovy: f32, aspect: f32, near: f32, far: f32): void {
  let f: f32 = (1.0 / tan((fovy * 0.5) as f64)) as f32;
  let range: f32 = 1.0 / (near - far);
  zero(out);
  out[0] = f / aspect;
  out[5] = f;
  out[10] = (far + near) * range;
  out[11] = -1.0;
  out[14] = 2.0 * far * near * range;
}

export fn ortho(out: *f32, left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32): void {
  zero(out);
  out[0] = 2.0 / (right - left);
  out[5] = 2.0 / (top - bottom);
  out[10] = -2.0 / (far - near);
  out[12] = 0.0 - (right + left) / (right - left);
  out[13] = 0.0 - (top + bottom) / (top - bottom);
  out[14] = 0.0 - (far + near) / (far - near);
  out[15] = 1.0;
}

export fn lookAt(out: *f32, eye: Vec3, target: Vec3, up: Vec3): void {
  let z: Vec3 = eye.sub(target).normalized();
  let x: Vec3 = up.cross(z).normalized();
  let y: Vec3 = z.cross(x);
  out[0] = x.x;
  out[1] = y.x;
  out[2] = z.x;
  out[3] = 0.0;
  out[4] = x.y;
  out[5] = y.y;
  out[6] = z.y;
  out[7] = 0.0;
  out[8] = x.z;
  out[9] = y.z;
  out[10] = z.z;
  out[11] = 0.0;
  out[12] = 0.0 - x.dot(eye);
  out[13] = 0.0 - y.dot(eye);
  out[14] = 0.0 - z.dot(eye);
  out[15] = 1.0;
}

// out = a * b; `out` must be neither.
export fn multiply(out: *f32, a: *f32, b: *f32): void {
  for (column in 0..4) {
    for (row in 0..4) {
      let sum: f32 = 0.0;
      for (k in 0..4) {
        sum += a[k * 4 + row] * b[column * 4 + k];
      }
      out[column * 4 + row] = sum;
    }
  }
}

// The inverse, by cofactors; `out` must not be `m`. A singular matrix gives
// zeros.
export fn invert(out: *f32, m: *f32): void {
  out[0] = m[5] * m[10] * m[15] - m[5] * m[11] * m[14] - m[9] * m[6] * m[15] + m[9] * m[7] * m[14] + m[13] * m[6] * m[11] - m[13] * m[7] * m[10];
  out[4] = 0.0 - m[4] * m[10] * m[15] + m[4] * m[11] * m[14] + m[8] * m[6] * m[15] - m[8] * m[7] * m[14] - m[12] * m[6] * m[11] + m[12] * m[7] * m[10];
  out[8] = m[4] * m[9] * m[15] - m[4] * m[11] * m[13] - m[8] * m[5] * m[15] + m[8] * m[7] * m[13] + m[12] * m[5] * m[11] - m[12] * m[7] * m[9];
  out[12] = 0.0 - m[4] * m[9] * m[14] + m[4] * m[10] * m[13] + m[8] * m[5] * m[14] - m[8] * m[6] * m[13] - m[12] * m[5] * m[10] + m[12] * m[6] * m[9];
  out[1] = 0.0 - m[1] * m[10] * m[15] + m[1] * m[11] * m[14] + m[9] * m[2] * m[15] - m[9] * m[3] * m[14] - m[13] * m[2] * m[11] + m[13] * m[3] * m[10];
  out[5] = m[0] * m[10] * m[15] - m[0] * m[11] * m[14] - m[8] * m[2] * m[15] + m[8] * m[3] * m[14] + m[12] * m[2] * m[11] - m[12] * m[3] * m[10];
  out[9] = 0.0 - m[0] * m[9] * m[15] + m[0] * m[11] * m[13] + m[8] * m[1] * m[15] - m[8] * m[3] * m[13] - m[12] * m[1] * m[11] + m[12] * m[3] * m[9];
  out[13] = m[0] * m[9] * m[14] - m[0] * m[10] * m[13] - m[8] * m[1] * m[14] + m[8] * m[2] * m[13] + m[12] * m[1] * m[10] - m[12] * m[2] * m[9];
  out[2] = m[1] * m[6] * m[15] - m[1] * m[7] * m[14] - m[5] * m[2] * m[15] + m[5] * m[3] * m[14] + m[13] * m[2] * m[7] - m[13] * m[3] * m[6];
  out[6] = 0.0 - m[0] * m[6] * m[15] + m[0] * m[7] * m[14] + m[4] * m[2] * m[15] - m[4] * m[3] * m[14] - m[12] * m[2] * m[7] + m[12] * m[3] * m[6];
  out[10] = m[0] * m[5] * m[15] - m[0] * m[7] * m[13] - m[4] * m[1] * m[15] + m[4] * m[3] * m[13] + m[12] * m[1] * m[7] - m[12] * m[3] * m[5];
  out[14] = 0.0 - m[0] * m[5] * m[14] + m[0] * m[6] * m[13] + m[4] * m[1] * m[14] - m[4] * m[2] * m[13] - m[12] * m[1] * m[6] + m[12] * m[2] * m[5];
  out[3] = 0.0 - m[1] * m[6] * m[11] + m[1] * m[7] * m[10] + m[5] * m[2] * m[11] - m[5] * m[3] * m[10] - m[9] * m[2] * m[7] + m[9] * m[3] * m[6];
  out[7] = m[0] * m[6] * m[11] - m[0] * m[7] * m[10] - m[4] * m[2] * m[11] + m[4] * m[3] * m[10] + m[8] * m[2] * m[7] - m[8] * m[3] * m[6];
  out[11] = 0.0 - m[0] * m[5] * m[11] + m[0] * m[7] * m[9] + m[4] * m[1] * m[11] - m[4] * m[3] * m[9] - m[8] * m[1] * m[7] + m[8] * m[3] * m[5];
  out[15] = m[0] * m[5] * m[10] - m[0] * m[6] * m[9] - m[4] * m[1] * m[10] + m[4] * m[2] * m[9] + m[8] * m[1] * m[6] - m[8] * m[2] * m[5];
  let det: f32 = m[0] * out[0] + m[1] * out[4] + m[2] * out[8] + m[3] * out[12];
  let scale: f32 = 0.0;
  if (det != 0.0) {
    scale = 1.0 / det;
  }
  for (i in 0..16) {
    out[i] = out[i] * scale;
  }
}

// Where `m` takes a point, divided through by w.
export fn transform(m: *f32, p: Vec3): Vec3 {
  let x: f32 = m[0] * p.x + m[4] * p.y + m[8] * p.z + m[12];
  let y: f32 = m[1] * p.x + m[5] * p.y + m[9] * p.z + m[13];
  let z: f32 = m[2] * p.x + m[6] * p.y + m[10] * p.z + m[14];
  let w: f32 = m[3] * p.x + m[7] * p.y + m[11] * p.z + m[15];
  return Vec3 { x: x / w, y: y / w, z: z / w };
}


fn near(a: f32, b: f32): bool {
  return absolute(a - b) < 0.0005;
}

test "a matrix times its inverse is the identity" {
  let view: *f32 = alloc<f32>(16);
  let projection: *f32 = alloc<f32>(16);
  let both: *f32 = alloc<f32>(16);
  let inverse: *f32 = alloc<f32>(16);
  let product: *f32 = alloc<f32>(16);
  lookAt(view, Vec3.new(10.0, 20.0, 30.0), Vec3.new(0.0, 1.0, 0.0), Vec3.new(0.0, 1.0, 0.0));
  perspective(projection, 0.75, 0.5, 0.5, 1400.0);
  multiply(both, projection, view);
  invert(inverse, both);
  multiply(product, both, inverse);
  for (i in 0..16) {
    let expected: f32 = 0.0;
    if (i % 5 == 0) {
      expected = 1.0;
    }
    assert(near(product[i], expected), "not the identity");
  }
}

test "the camera's target lands in the middle of the screen" {
  let view: *f32 = alloc<f32>(16);
  let projection: *f32 = alloc<f32>(16);
  let both: *f32 = alloc<f32>(16);
  lookAt(view, Vec3.new(5.0, 8.0, -3.0), Vec3.new(1.0, 0.0, 2.0), Vec3.new(0.0, 1.0, 0.0));
  perspective(projection, 0.75, 1.0, 0.5, 100.0);
  multiply(both, projection, view);
  let p: Vec3 = transform(both, Vec3.new(1.0, 0.0, 2.0));
  assert(near(p.x, 0.0) && near(p.y, 0.0), "the target is off centre");
  assert(p.z > -1.0 && p.z < 1.0, "the target is clipped");
}

test "ortho maps its box onto the unit cube" {
  let m: *f32 = alloc<f32>(16);
  ortho(m, -10.0, 10.0, -5.0, 5.0, 1.0, 21.0);
  let corner: Vec3 = transform(m, Vec3.new(10.0, 5.0, -21.0));
  assert(near(corner.x, 1.0) && near(corner.y, 1.0) && near(corner.z, 1.0), "far corner");
}

test "vectors" {
  let x: Vec3 = Vec3.new(1.0, 0.0, 0.0);
  let y: Vec3 = Vec3.new(0.0, 1.0, 0.0);
  assertEq(x.cross(y).z, 1.0);
  assertEq(Vec3.new(3.0, 4.0, 0.0).length() > 4.999, true);
  assert(near(squareRoot(0.01), 0.1), "sqrt 0.01");
}

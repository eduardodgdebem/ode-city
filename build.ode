// ---------------------------------------------------------------------------
// Ode City: a focus timer that builds a city.
//
//   ode build              build web/city.wasm, the app's logic
//   ode build test         run the tests of everything but the renderer
//   ode build serve        build, then serve web/ on http://localhost:8080
//   ode build serve -- 9000   on another port
//
// The app is web/: a PWA that loads city.wasm and runs offline once loaded.
// `serve` is only for trying it out; any static host serves web/ as it is.
// ---------------------------------------------------------------------------

import { Build, Artifact } from "std/build";

export fn build(b: *Build): void {
  let app: *Artifact = b.executable("city", "src/app.ode");
  app.target = "wasm32";
  app.output = "web/city.wasm";
  app.release = true;

  // Not "src": what calls WebGL cannot link natively (src/logic.test.ode).
  b.tests("src/logic.test.ode");

  let serve: *Artifact = b.tool("serve", "tools/serve.ode");
  b.step("serve", "build, then serve web/ on http://localhost:8080")
      .run(serve).arg("web").argOutput(app);
}

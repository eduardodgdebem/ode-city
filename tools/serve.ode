// ---------------------------------------------------------------------------
// A static file server, for trying the app out: `ode build serve`.
//
//   serve <dir> [ignored...] [port]
//
// It is ode-http (../ode-http) serving one directory, and every file with
// Cache-Control: no-cache, so a reload always gets what was just built.
// That is all a PWA needs: once its service worker has the files, the app
// runs with no server at all. A service worker only registers on localhost
// or over HTTPS, so on a phone reached through this Mac's address the app
// runs, but not offline; host web/ on any HTTPS static host for that.
// ---------------------------------------------------------------------------

import { Builder, parseInt } from "std/text";
import { println, eprintln, flush } from "std/io";
import { App, Request, Response } from "../ode-http/http";

fn main(argc: i32, argv: **i8): i32 {
  if (argc < 2) {
    eprintln("usage: serve <dir> [port]");
    return 2;
  }
  let root: *i8 = argv[1];
  let port: i32 = 8080;
  if (argc > 2) {
    port = (parseInt(argv[argc - 1]) ?? 8080) as i32;
  }

  let app: *App = App.new();
  app.use(noCache);
  app.serveStatic("/", root);

  let url: *Builder = Builder.new();
  url.add("serving ");
  url.add(root);
  url.add(" on http://localhost:");
  url.addInt(port as i64);
  println(url.take());
  println("on a phone on this network: http://<this computer's address>, e.g. `ipconfig getifaddr en0`");
  flush();

  app.listen(port) catch (e) {
    eprintln("serve: cannot listen there; is the port taken?");
    return 1;
  };
  return 0;
}

fn noCache(request: *Request, response: *Response): bool {
  response.setHeader("Cache-Control", "no-cache");
  return true;
}

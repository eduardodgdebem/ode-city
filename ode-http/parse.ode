// ---------------------------------------------------------------------------
// Reading a request: the bytes off the connection, the request line and
// headers out of them, and the body after.
//
// The head -- request line and headers -- is read until the blank line that
// ends it, and may be at most MAX_HEAD bytes; the body is as long as its
// Content-Length says, at most MAX_BODY. Chunked bodies are not read: a
// request sending one is refused as malformed.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { alloc, grow, copy } from "std/mem";
import { Builder, indexOf, slice, equals, parseInt } from "std/text";
import { read } from "std/c";
import { Header, HttpError, Method, Request } from "./http";

let MAX_HEAD: i64 = 16384;
let MAX_BODY: i64 = 8388608;

// Reads one request from `fd`: `Closed` when the connection ends or goes
// quiet first, `TooLarge` past the limits, `Malformed` when it is not HTTP.
export fn readRequest(fd: i32): *Request | HttpError {
  let capacity: i64 = 4096;
  let buffer: *i8 = alloc<i8>(capacity + 1);
  let used: i64 = 0;
  let headEnd: i64 = -1;
  while (headEnd < 0) {
    if (used == capacity) {
      if (capacity >= MAX_HEAD) {
        return HttpError.TooLarge;
      }
      capacity = capacity * 2;
      buffer = grow<i8>(buffer, capacity + 1);
    }
    let got: isize = read(fd, buffer + used, (capacity - used) as isize);
    if (got <= 0) {
      return HttpError.Closed;
    }
    used += got as i64;
    buffer[used] = 0;
    headEnd = indexOf(buffer, "\r\n\r\n");
  }

  let request: *Request = Request.empty();
  try parseHead(slice(buffer, 0, headEnd), request);

  let declared: *i8 = request.header("Transfer-Encoding");
  if (declared != null) {
    return HttpError.Malformed;
  }
  let bodyLength: i64 = 0;
  let lengthText: *i8 = request.header("Content-Length");
  if (lengthText != null) {
    bodyLength = parseInt(lengthText) catch (e) {
      return HttpError.Malformed;
    };
  }
  if (bodyLength < 0) {
    return HttpError.Malformed;
  }
  if (bodyLength > MAX_BODY) {
    return HttpError.TooLarge;
  }

  // What came with the head, then the rest.
  let body: *i8 = alloc<i8>(bodyLength + 1);
  let start: i64 = headEnd + 4;
  let have: i64 = used - start;
  if (have > bodyLength) {
    have = bodyLength;
  }
  copy<i8>(body, buffer + start, have);
  while (have < bodyLength) {
    let got: isize = read(fd, body + have, (bodyLength - have) as isize);
    if (got <= 0) {
      return HttpError.Closed;
    }
    have += got as i64;
  }
  body[bodyLength] = 0;
  request.body = body;
  request.bodyLength = bodyLength;
  return request;
}

// The request line and the headers, from `head` -- everything before the
// blank line -- into `request`.
export fn parseHead(head: *i8, request: *Request): void | HttpError {
  let lineEnd: i64 = indexOf(head, "\r\n");
  let line: *i8 = head;
  let rest: *i8 = "";
  if (lineEnd >= 0) {
    line = slice(head, 0, lineEnd);
    rest = head + lineEnd + 2;
  }

  // METHOD SP target SP version
  let firstSpace: i64 = indexOf(line, " ");
  if (firstSpace <= 0) {
    return HttpError.Malformed;
  }
  let afterMethod: *i8 = line + firstSpace + 1;
  let secondSpace: i64 = indexOf(afterMethod, " ");
  if (secondSpace <= 0) {
    return HttpError.Malformed;
  }
  request.methodName = slice(line, 0, firstSpace);
  request.method = methodOf(request.methodName);
  request.target = slice(afterMethod, 0, secondSpace);
  request.version = slice(afterMethod, secondSpace + 1, length(afterMethod) - secondSpace - 1);
  if (request.target[0] != '/' || indexOf(request.version, "HTTP/") != 0) {
    return HttpError.Malformed;
  }
  let question: i64 = indexOf(request.target, "?");
  if (question >= 0) {
    request.path = percentDecode(slice(request.target, 0, question), false);
    request.query = slice(request.target, question + 1, length(request.target) - question - 1);
  } else {
    request.path = percentDecode(request.target, false);
    request.query = "";
  }

  // Name: value, a line each.
  while (rest[0] != 0) {
    let end: i64 = indexOf(rest, "\r\n");
    let headerLine: *i8 = rest;
    if (end >= 0) {
      headerLine = slice(rest, 0, end);
      rest = rest + end + 2;
    } else {
      rest = "";
    }
    let colon: i64 = indexOf(headerLine, ":");
    if (colon <= 0) {
      return HttpError.Malformed;
    }
    let value: *i8 = headerLine + colon + 1;
    while (value[0] == ' ' || value[0] == '\t') {
      value = value + 1;
    }
    let valueLength: i64 = length(value);
    while (valueLength > 0 && (value[valueLength - 1] == ' ' || value[valueLength - 1] == '\t')) {
      valueLength -= 1;
    }
    request.headers.push(Header { name: slice(headerLine, 0, colon), value: slice(value, 0, valueLength) });
  }
}

export fn methodOf(name: *i8): Method {
  if (equals(name, "GET")) {
    return Method.Get;
  }
  if (equals(name, "HEAD")) {
    return Method.Head;
  }
  if (equals(name, "POST")) {
    return Method.Post;
  }
  if (equals(name, "PUT")) {
    return Method.Put;
  }
  if (equals(name, "PATCH")) {
    return Method.Patch;
  }
  if (equals(name, "DELETE")) {
    return Method.Delete;
  }
  if (equals(name, "OPTIONS")) {
    return Method.Options;
  }
  return Method.Other;
}

// `%XX` as the byte it stands for, and `+` as a space when `plusIsSpace`,
// as it is in a query. A `%` not followed by two hex digits is kept as it is.
export fn percentDecode(text: *i8, plusIsSpace: bool): *i8 {
  let out: *Builder = Builder.new();
  let i: i64 = 0;
  while (text[i] != 0) {
    let c: i8 = text[i];
    if (c == '%' && hexValue(text[i + 1]) >= 0 && hexValue(text[i + 2]) >= 0) {
      out.push((hexValue(text[i + 1]) * 16 + hexValue(text[i + 2])) as i8);
      i += 3;
    } else if (c == '+' && plusIsSpace) {
      out.push(' ');
      i += 1;
    } else {
      out.push(c);
      i += 1;
    }
  }
  return out.take();
}

fn hexValue(c: i8): i32 {
  if (c >= '0' && c <= '9') {
    return (c - '0') as i32;
  }
  if (c >= 'a' && c <= 'f') {
    return (c - 'a') as i32 + 10;
  }
  if (c >= 'A' && c <= 'F') {
    return (c - 'A') as i32 + 10;
  }
  return -1;
}

// Header names are compared as HTTP does, ignoring case.
export fn sameIgnoringCase(a: *i8, b: *i8): bool {
  let i: i64 = 0;
  while (a[i] != 0 && b[i] != 0) {
    if (lower(a[i]) != lower(b[i])) {
      return false;
    }
    i += 1;
  }
  return a[i] == b[i];
}

fn lower(c: i8): i8 {
  if (c >= 'A' && c <= 'Z') {
    return (c + 32) as i8;
  }
  return c;
}

// The value of `name` in a query such as `a=1&b=two+words`, decoded; null
// when it is not there, and "" when it is there with no value.
export fn queryValue(query: *i8, name: *i8): *i8 {
  let rest: *i8 = query;
  while (rest[0] != 0) {
    let end: i64 = indexOf(rest, "&");
    let pair: *i8 = rest;
    if (end >= 0) {
      pair = slice(rest, 0, end);
      rest = rest + end + 1;
    } else {
      rest = "";
    }
    let equal: i64 = indexOf(pair, "=");
    let key: *i8 = pair;
    let value: *i8 = "";
    if (equal >= 0) {
      key = slice(pair, 0, equal);
      value = pair + equal + 1;
    }
    if (equals(percentDecode(key, true), name)) {
      return percentDecode(value, true);
    }
  }
  return null;
}

fn length(text: *i8): i64 {
  let n: i64 = 0;
  while (text[n] != 0) {
    n += 1;
  }
  return n;
}

test "a request line and headers" {
  let request: *Request = Request.empty();
  parseHead("GET /users/42?sort=new HTTP/1.1\r\nHost: localhost:8080\r\nAccept:  text/html  ", request) catch (e) {
    assert(false, "parses");
    return;
  };
  assertEq(request.method, Method.Get);
  assertEq(request.methodName, "GET");
  assertEq(request.target, "/users/42?sort=new");
  assertEq(request.path, "/users/42");
  assertEq(request.query, "sort=new");
  assertEq(request.version, "HTTP/1.1");
  assertEq(request.headers.count, 2);
  assertEq(request.header("host"), "localhost:8080");
  assertEq(request.header("ACCEPT"), "text/html");
  assert(request.header("Cookie") == null, "a header not sent is null");
}

test "what is not HTTP is malformed" {
  let request: *Request = Request.empty();
  assert(parseHead("hello", request) is HttpError, "no spaces");
  assert(parseHead("GET nowhere HTTP/1.1", Request.empty()) is HttpError, "a target not a path");
  assert(parseHead("GET / SMTP", Request.empty()) is HttpError, "not HTTP");
  assert(parseHead("GET / HTTP/1.1\r\nno colon here", Request.empty()) is HttpError, "a header without a colon");
}

test "methods by name" {
  assertEq(methodOf("POST"), Method.Post);
  assertEq(methodOf("DELETE"), Method.Delete);
  assertEq(methodOf("BREW"), Method.Other);
}

test "percent decoding" {
  assertEq(percentDecode("hello%20world", false), "hello world");
  assertEq(percentDecode("a+b", false), "a+b");
  assertEq(percentDecode("a+b", true), "a b");
  assertEq(percentDecode("100%", false), "100%");
  assertEq(percentDecode("%E2%9C%93", false), "\xe2\x9c\x93");
}

test "query values" {
  assertEq(queryValue("a=1&name=ode+city&empty=", "name"), "ode city");
  assertEq(queryValue("a=1&name=ode+city&empty=", "a"), "1");
  assertEq(queryValue("a=1&name=ode+city&empty=", "empty"), "");
  assertEq(queryValue("flag&x=%2F", "x"), "/");
  assert(queryValue("a=1", "b") == null, "absent");
  assert(queryValue("", "a") == null, "an empty query has nothing");
}

test "header names ignore case" {
  assert(sameIgnoringCase("Content-Length", "content-length"), "same");
  assert(!sameIgnoringCase("Content-Length", "Content-Type"), "different");
  assert(!sameIgnoringCase("Host", "Hostname"), "a prefix is not the same");
}

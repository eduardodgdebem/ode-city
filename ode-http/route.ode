// ---------------------------------------------------------------------------
// Route patterns: whether a path is one a route answers, and what its
// named parts are.
//
//   /                     only the root
//   /about                only /about
//   /users/:id            /users/42, with id = "42"
//   /files/*              /files/a/b.txt, with * = "a/b.txt"
//
// A part is compared whole, between slashes. `:name` takes any one part,
// and `*`, last, takes all that is left, slashes and all. A slash at the end
// of a path is ignored, so /about/ is /about.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { slice } from "std/text";
import { Header } from "./http";
import { percentDecode } from "./parse";

// Whether `path` matches `pattern`; if it does, its named parts are pushed
// onto `params`, decoded.
export fn matchRoute(pattern: *i8, path: *i8, params: *List<Header>): bool {
  let found: *List<Header> = List<Header>.new();
  let p: i64 = 0;
  let q: i64 = 0;
  while (true) {
    p = skipSlash(pattern, p);
    q = skipSlash(path, q);
    if (pattern[p] == 0) {
      if (path[q] != 0) {
        return false;
      }
      break;
    }
    let partEnd: i64 = endOfPart(pattern, p);
    // The rest of the path, whatever it is.
    if (pattern[p] == '*' && partEnd == p + 1) {
      let rest: i64 = q;
      while (path[rest] != 0) {
        rest += 1;
      }
      while (rest > q && path[rest - 1] == '/') {
        rest -= 1;
      }
      found.push(Header { name: "*", value: percentDecode(slice(path, q, rest - q), false) });
      break;
    }
    if (path[q] == 0) {
      return false;
    }
    let pathEnd: i64 = endOfPart(path, q);
    if (pattern[p] == ':') {
      found.push(Header {
        name: slice(pattern, p + 1, partEnd - p - 1),
        value: percentDecode(slice(path, q, pathEnd - q), false),
      });
    } else if (!samePart(pattern, p, partEnd, path, q, pathEnd)) {
      return false;
    }
    p = partEnd;
    q = pathEnd;
  }
  for (i in 0..found.count) {
    params.push(found.at(i));
  }
  return true;
}

fn skipSlash(text: *i8, at: i64): i64 {
  if (text[at] == '/') {
    return at + 1;
  }
  return at;
}

fn endOfPart(text: *i8, at: i64): i64 {
  let end: i64 = at;
  while (text[end] != 0 && text[end] != '/') {
    end += 1;
  }
  return end;
}

fn samePart(a: *i8, aStart: i64, aEnd: i64, b: *i8, bStart: i64, bEnd: i64): bool {
  if (aEnd - aStart != bEnd - bStart) {
    return false;
  }
  for (i in 0..aEnd - aStart) {
    if (a[aStart + i] != b[bStart + i]) {
      return false;
    }
  }
  return true;
}

fn valueOf(params: *List<Header>, name: *i8): *i8 {
  for (i in 0..params.count) {
    let param: Header = params.at(i);
    let same: bool = true;
    let k: i64 = 0;
    while (same && (param.name[k] != 0 || name[k] != 0)) {
      same = param.name[k] == name[k];
      k += 1;
    }
    if (same) {
      return param.value;
    }
  }
  return null;
}

test "plain routes match only themselves" {
  let params: *List<Header> = List<Header>.new();
  assert(matchRoute("/", "/", params), "the root");
  assert(!matchRoute("/", "/about", params), "the root is only the root");
  assert(matchRoute("/about", "/about", params), "a plain path");
  assert(matchRoute("/about", "/about/", params), "a slash at the end is ignored");
  assert(!matchRoute("/about", "/abouts", params), "parts compare whole");
  assert(!matchRoute("/about/team", "/about", params), "too short");
  assert(!matchRoute("/about", "/about/team", params), "too long");
  assertEq(params.count, 0);
}

test "named parts are taken out, decoded" {
  let params: *List<Header> = List<Header>.new();
  assert(matchRoute("/users/:id/posts/:post", "/users/42/posts/hello%20world", params), "matches");
  assertEq(valueOf(params, "id"), "42");
  assertEq(valueOf(params, "post"), "hello world");
}

test "a failed match leaves the params alone" {
  let params: *List<Header> = List<Header>.new();
  assert(!matchRoute("/users/:id/edit", "/users/42/view", params), "no match");
  assertEq(params.count, 0);
}

test "a star takes the rest" {
  let params: *List<Header> = List<Header>.new();
  assert(matchRoute("/files/*", "/files/a/b.txt", params), "matches");
  assertEq(valueOf(params, "*"), "a/b.txt");
  let none: *List<Header> = List<Header>.new();
  assert(matchRoute("/files/*", "/files", none), "nothing left is still a match");
  assertEq(valueOf(none, "*"), "");
}
